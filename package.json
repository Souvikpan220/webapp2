{
  "name": "kaddu-boost-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "frontend": "npm run dev --workspace frontend",
    "backend": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend",
    "preview": "npm run preview --workspace frontend",
    "check": "npm run check --workspace frontend && npm run check --workspace backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
